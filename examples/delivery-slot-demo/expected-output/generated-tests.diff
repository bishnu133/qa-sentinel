+import type { ApiClient } from "./client";
+import type { DataFactory } from "../data/builders";
+
+export interface CreatedOrder {
+  id: string;
+  item: string;
+  qty: number;
+  deliverySlot: string;
+}
+
+/**
+ * Setup helper: creates an order through POST /orders with the given slot and returns it.
+ * Throws if the service does not answer 201, so setup failures are not mistaken for test failures.
+ * Use the raw `api.post` in the test itself when the response under test is the one being asserted.
+ */
+export async function createOrderWithSlot(
+  api: ApiClient,
+  deliverySlot: string,
+  overrides: { item?: string; qty?: number } = {},
+): Promise<CreatedOrder> {
+  const res = await api.post("/orders", { item: "book", qty: 1, ...overrides, deliverySlot });
+  if (res.status() !== 201) {
+    throw new Error(`Setup: POST /orders for slot ${deliverySlot} returned ${res.status()}: ${await res.text()}`);
+  }
+  return (await res.json()) as CreatedOrder;
+}
+
+/**
+ * Setup helper: books `count` orders into `deliverySlot` (default: a fresh unique slot).
+ * Returns the slot and the created orders. Use count = 3 to bring a slot to capacity (AC SHOP-42),
+ * then POST a further order in the test to assert the 409.
+ */
+export async function fillSlot(
+  api: ApiClient,
+  data: DataFactory,
+  count: number,
+  deliverySlot: string = data.futureSlot(),
+): Promise<{ deliverySlot: string; orders: CreatedOrder[] }> {
+  const orders: CreatedOrder[] = [];
+  for (let i = 0; i < count; i++) {
+    orders.push(await createOrderWithSlot(api, deliverySlot)); // sequential: avoids racing the capacity check
+  }
+  return { deliverySlot, orders };
+}
