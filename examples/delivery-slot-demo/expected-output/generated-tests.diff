+  /** Unique future ISO date-time (a distinct slot per call, so per-slot capacity is never shared between tests). */
+  futureSlot(daysAhead = 30): string {
+    this.seq += 1;
+    const base = Date.now() + daysAhead * 24 * 60 * 60 * 1000;
+    return new Date(base + this.seq * 1000 + Math.floor(Math.random() * 1000) * 1000).toISOString();
+  }
+
+  /** ISO date-time in the past. */
+  pastSlot(): string {
+    return new Date(Date.now() - 24 * 60 * 60 * 1000).toISOString();
