+  /** Unique ISO 8601 delivery slot in the future, so tests never share slot capacity. */
+  deliverySlot(): string {
+    this.seq += 1;
+    const base = Date.now() + 30 * 24 * 60 * 60 * 1000;
+    const jitter = Math.floor(Math.random() * 1_000_000) * 1000;
+    return new Date(base + jitter + this.seq).toISOString();
+  }
+
+  /** ISO 8601 delivery slot in the past. */
+  pastDeliverySlot(): string {
+    return new Date(Date.now() - 24 * 60 * 60 * 1000).toISOString();
