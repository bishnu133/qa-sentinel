     return `${prefix}-${this.runId}-${this.seq}`;
   }
 
+  /**
+   * Unique future ISO 8601 delivery slot (UTC, ms precision). The service counts capacity by exact
+   * string match, so each call returns a slot nobody else uses: random offset of 1..~30 days plus a
+   * per-factory sequence in ms. Safe for parallel workers and repeated runs against a long-lived service.
+   */
+  futureSlot(): string {
+    this.seq += 1;
+    const day = 24 * 60 * 60 * 1000;
+    const offset = day + Math.floor(Math.random() * 30 * day) + this.seq;
+    return new Date(Date.now() + offset).toISOString();
+  }
+
