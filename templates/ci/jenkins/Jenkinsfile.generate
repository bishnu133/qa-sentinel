// qa-sentinel – Phase 2 test generation. Runs in the TEST repo job, triggered after a service merge:
//   build job: 'qa-sentinel-generate', wait: false, parameters: [
//     string(name: 'QA_SERVICE_NAME', value: 'orders-service'),
//     string(name: 'QA_SERVICE_REPO', value: env.GIT_URL),
//     string(name: 'QA_SERVICE_SHA', value: env.GIT_COMMIT),
//     string(name: 'QA_SERVICE_BEFORE_SHA', value: env.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: '')]
pipeline {
  agent { docker { image 'mcr.microsoft.com/playwright:v1.49.0-noble' } }
  // disableConcurrentBuilds: one write-enabled generation at a time for the whole test repo.
  options { timeout(time: 45, unit: 'MINUTES'); disableConcurrentBuilds() }
  parameters {
    string(name: 'QA_SERVICE_NAME', description: 'Service name in qa-sentinel.config.yaml')
    string(name: 'QA_SERVICE_REPO', description: 'Service repo URL')
    string(name: 'QA_SERVICE_SHA', description: 'Merged commit')
    string(name: 'QA_SERVICE_BEFORE_SHA', defaultValue: '', description: 'Previous commit (default: SHA~1)')
    string(name: 'QA_SERVICE_PROJECT', defaultValue: '', description: 'GitLab project path of the service (to fetch the MR acceptance criteria)')
  }
  environment {
    ANTHROPIC_API_KEY = credentials('anthropic-api-key')
    QA_SENTINEL_GITLAB_TOKEN = credentials('qa-sentinel-gitlab-token')
    {{baseUrlEnv}} = credentials('qa-base-url')
    HOME = "${env.WORKSPACE}"
  }
  stages {
    stage('Prepare') {
      steps {
        sh 'npm ci'
        sh '''
          # Install qa-sentinel from QA_SENTINEL_PACKAGE; a GitHub source is cloned, built and packed first.
          qa_pkg="${QA_SENTINEL_PACKAGE:-qa-sentinel@0.2.0}"
          case "$qa_pkg" in
            github:*|git+https://github.com/*|https://github.com/*)
              src="${qa_pkg#github:}"; src="${src#git+}"; src="${src#https://github.com/}"
              repo="${src%%#*}"; repo="${repo%.git}"; ref="main"
              case "$src" in *"#"*) ref="${src#*#}" ;; esac
              rm -rf "$WORKSPACE/.qa-sentinel-src" "$WORKSPACE"/qa-sentinel-*.tgz
              git clone -q --depth 1 --branch "$ref" "https://github.com/${repo}.git" "$WORKSPACE/.qa-sentinel-src"
              (cd "$WORKSPACE/.qa-sentinel-src" && npm ci --no-audit --no-fund --loglevel=error && npm pack --silent --pack-destination "$WORKSPACE" > /dev/null)
              qa_pkg="$(ls "$WORKSPACE"/qa-sentinel-*.tgz | head -n 1)"
              ;;
          esac
          npm i -g --prefix "$WORKSPACE/.npm-global" --no-audit --no-fund --loglevel=error @anthropic-ai/claude-code "$qa_pkg"
        '''
        dir("/tmp/services/${params.QA_SERVICE_NAME}") {
          git url: params.QA_SERVICE_REPO, branch: 'main', credentialsId: 'gitlab-checkout'
          // Pin to the merged commit and drop the remote before any agent runs.
          sh 'git checkout --quiet --detach "$QA_SERVICE_SHA" && git remote remove origin'
        }
        sh 'git config user.name qa-sentinel && git config user.email qa-sentinel@noreply.local'
      }
    }
    stage('Generate') {
      steps {
        // qa-sentinel pushes with a one-off URL built from QA_SENTINEL_GITLAB_TOKEN + ci.testRepoProject
        // (never stored in .git/config) and never passes the token to the agent or the tests.
        sh '''
          export PATH="$WORKSPACE/.npm-global/bin:$PATH"
          BASE="${QA_SERVICE_BEFORE_SHA:-${QA_SERVICE_SHA}~1}"
          QA_SERVICE_PROJECT="${QA_SERVICE_PROJECT:-}" qa-sentinel generate --service "$QA_SERVICE_NAME" \
            --service-path "/tmp/services/$QA_SERVICE_NAME" --base "$BASE" --head "$QA_SERVICE_SHA" --push
        '''
      }
    }
  }
  post {
    always { archiveArtifacts artifacts: 'qa-sentinel-summary.md, .qa-sentinel/runs/**', allowEmptyArchive: true }
  }
}
