// qa-sentinel – run API tests (agent MRs, schedules, post-deploy). Set QA_TEST_ARGS to filter, e.g. --grep @service:orders
pipeline {
  agent { docker { image 'mcr.microsoft.com/playwright:v1.49.0-noble' } }
  options { timeout(time: 30, unit: 'MINUTES') }
  parameters {
    string(name: 'QA_TEST_ARGS', defaultValue: '', description: 'Extra arguments for the test command')
    booleanParam(name: 'CHANGED_ONLY', defaultValue: false, description: 'Run only specs changed vs {{targetBranch}} (agent MRs)')
  }
  environment {
    {{baseUrlEnv}} = credentials('qa-base-url')
    HOME = "${env.WORKSPACE}"
  }
  stages {
    stage('Install') { steps { sh 'npm ci{{#if webEnabled}} && npx playwright install chromium{{/if}}' } }
    stage('Verify changed tests') {
      // Agent MRs: the same blocking checks qa-sentinel runs after generation (policy, tsc, changed specs, JUnit).
      when { expression { params.CHANGED_ONLY } }
      steps {
        sh '''
          # Install qa-sentinel from QA_SENTINEL_PACKAGE; a GitHub source is cloned, built and packed first.
          qa_pkg="${QA_SENTINEL_PACKAGE:-qa-sentinel@0.5.0}"
          case "$qa_pkg" in
            github:*|git+https://github.com/*|https://github.com/*)
              src="${qa_pkg#github:}"; src="${src#git+}"; src="${src#https://github.com/}"
              repo="${src%%#*}"; repo="${repo%.git}"; ref="main"
              case "$src" in *"#"*) ref="${src#*#}" ;; esac
              rm -rf "$WORKSPACE/.qa-sentinel-src" "$WORKSPACE"/qa-sentinel-*.tgz
              git clone -q --depth 1 --branch "$ref" "https://github.com/${repo}.git" "$WORKSPACE/.qa-sentinel-src"
              (cd "$WORKSPACE/.qa-sentinel-src" && npm ci --no-audit --no-fund --loglevel=error && npm pack --silent --pack-destination "$WORKSPACE" > /dev/null)
              qa_pkg="$(ls "$WORKSPACE"/qa-sentinel-*.tgz | head -n 1)"
              ;;
          esac
          npm i -g --prefix "$WORKSPACE/.npm-global" --no-audit --no-fund --loglevel=error "$qa_pkg"
          export PATH="$WORKSPACE/.npm-global/bin:$PATH"
          git fetch origin {{targetBranch}}
          qa-sentinel verify --policy --base origin/{{targetBranch}} --out qa-verify.md
        '''
      }
    }
    stage('Type-check') {
      when { expression { !params.CHANGED_ONLY } }
      steps { sh 'npx tsc --noEmit' }   // blocking: a type error fails the build
    }
    stage('API tests') {
      when { expression { !params.CHANGED_ONLY } }
      steps { sh '{{#if healingBubblegum}}python3 -m pip install --quiet --break-system-packages "bubblegum-ai[web]" && {{/if}}{{#if webEnabled}}QA_HEALING=${QA_HEALING:-{{healingVar}}} {{/if}}{{suiteRunCommand}} $QA_TEST_ARGS' }
    }
{{#if mobileEnabled}}
    stage('Mobile tests') {
      // Needs a device: runs when QA_APPIUM_URL points at an Appium server (device farm or an agent with an emulator).
      when { expression { !params.CHANGED_ONLY && env.QA_APPIUM_URL } }
      steps { sh '{{mobileRunCommand}} $QA_MOBILE_TEST_ARGS' }
    }
{{/if}}
  }
  post {
    always {
      junit testResults: 'test-results/junit.xml, .qa-sentinel/runs/*/junit*.xml{{#if mobileEnabled}}, test-results/mobile/junit/*.xml, .qa-sentinel/runs/*/junit-mobile/*.xml{{/if}}', allowEmptyResults: true
      archiveArtifacts artifacts: 'playwright-report/**, test-results/**, qa-verify.md, .qa-sentinel/runs/**', allowEmptyArchive: true
    }
  }
}
