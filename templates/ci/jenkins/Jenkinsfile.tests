// qa-sentinel – run API tests (agent MRs, schedules, post-deploy). Set QA_TEST_ARGS to filter, e.g. --grep @service:orders
pipeline {
  agent { docker { image 'mcr.microsoft.com/playwright:v1.49.0-noble' } }
  options { timeout(time: 30, unit: 'MINUTES') }
  parameters {
    string(name: 'QA_TEST_ARGS', defaultValue: '', description: 'Extra arguments for the test command')
    booleanParam(name: 'CHANGED_ONLY', defaultValue: false, description: 'Run only specs changed vs {{targetBranch}} (agent MRs)')
  }
  environment {
    {{baseUrlEnv}} = credentials('qa-base-url')
    HOME = "${env.WORKSPACE}"
  }
  stages {
    stage('Install') { steps { sh 'npm ci' } }
    stage('Verify changed tests') {
      // Agent MRs: the same blocking checks qa-sentinel runs after generation (policy, tsc, changed specs, JUnit).
      when { expression { params.CHANGED_ONLY } }
      steps {
        sh '''
          npm i -g --prefix "$WORKSPACE/.npm-global" "${QA_SENTINEL_PACKAGE:-qa-sentinel@0.2.0}"
          export PATH="$WORKSPACE/.npm-global/bin:$PATH"
          git fetch origin {{targetBranch}}
          qa-sentinel verify --policy --base origin/{{targetBranch}} --out qa-verify.md
        '''
      }
    }
    stage('Type-check') {
      when { expression { !params.CHANGED_ONLY } }
      steps { sh 'npx tsc --noEmit' }   // blocking: a type error fails the build
    }
    stage('API tests') {
      when { expression { !params.CHANGED_ONLY } }
      steps { sh '{{runCommand}} $QA_TEST_ARGS' }
    }
  }
  post {
    always {
      junit testResults: 'test-results/junit.xml, .qa-sentinel/runs/*/junit.xml', allowEmptyResults: true
      archiveArtifacts artifacts: 'playwright-report/**, test-results/**, qa-verify.md, .qa-sentinel/runs/**', allowEmptyArchive: true
    }
  }
}
