import { driver } from "@wdio/globals";
import type { El, Ui } from "../mobile/ui";

/**
 * One class per app screen. Elements are getters (accessibility ids first: `$("~place-order")`), actions are
 * methods named after what the user does, and every action goes through `this.ui` with a human name.
 */
export abstract class BaseScreen {
  /** The screen's name or deep-link route, the same value as the specs' @screen tag (e.g. "orders/new"). */
  abstract readonly screen: string;
  /** An element only this screen shows; `waitForOpen()` waits for it. */
  abstract get root(): El;

  constructor(protected readonly ui: Ui) {}

  async waitForOpen(timeout = 15_000): Promise<this> {
    await this.root.waitForDisplayed({ timeout });
    return this;
  }

  /** Open a deep link (myapp://orders/new) when the app supports them (Android only for now): faster and steadier than tapping there. */
  async openDeepLink(url: string): Promise<this> {
    // The app's package: from the session (an installed APK reports it) or QA_APP_PACKAGE.
    const pkg = (driver.capabilities as Record<string, unknown>).appPackage ?? process.env.QA_APP_PACKAGE;
    if (driver.isAndroid) await driver.execute("mobile: deepLink", { url, package: pkg });
    else
      // Not supported yet: the XCUITest driver's deep-link command was not confirmed against its documentation, and a plain
      // `driver.url()` opens Safari, not the app. Open the screen by tapping, or ask the team to add iOS support after checking.
      throw new Error(`openDeepLink is not supported on iOS yet (${url}). Reach the screen through the UI instead.`);
    return this.waitForOpen();
  }
}
