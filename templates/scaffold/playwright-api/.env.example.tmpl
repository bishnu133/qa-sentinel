# Copy to .env for local runs. In CI, set these as masked variables.
{{baseUrlEnv}}=https://qa.example.internal
{{#if webEnabled}}
# Web tests: the front end, and the browser when Playwright's own Chromium can't be downloaded.
{{webBaseUrlEnv}}=https://qa.example.internal/
# QA_BROWSER_CHANNEL=chrome
# QA_HEADED=1
# Runtime locator healing in scheduled runs (needs Bubblegum installed): QA_HEALING=bubblegum
{{/if}}
