import fs from "node:fs";
import { test as base, expect } from "@playwright/test";
import { ApiClient } from "../api/client";
import { DataFactory } from "../data/builders";
import { DataLedger } from "../data/ledger";

interface Fixtures {
  api: ApiClient;
  data: DataFactory;
}

/** Import `test` and `expect` from here in every API spec. */
export const test = base.extend<Fixtures>({
  api: async ({ request }, use, testInfo) => {
    const api = new ApiClient(request);
    await use(api);
    // Evidence for qa-sentinel's showcase stage: the requests this test made and what came back.
    if (api.calls.length && process.env.QA_API_LOG !== "off") {
      const file = testInfo.outputPath("api-log.json");
      fs.writeFileSync(file, JSON.stringify({ test: testInfo.title, status: testInfo.status, calls: api.calls }, null, 2));
      await testInfo.attach("api-log", { path: file, contentType: "application/json" });
    }
  },
  data: async ({ request }, use, testInfo) => {
    // Everything the test tracks is deleted newest first when it ends, passed or failed.
    const ledger = new DataLedger(request, testInfo.titlePath.join(" › "), `${testInfo.testId}-${testInfo.retry}`);
    await use(new DataFactory(`${testInfo.workerIndex}-${Date.now()}`, ledger));
    const failed = await ledger.cleanup();
    if (failed.length) testInfo.annotations.push({ type: "data-cleanup-failed", description: failed.join("; ") });
  },
});

export { expect };
